# ============ LLM（OpenAI 兼容接口） ============
# 任意 OpenAI 兼容服务均可：OpenAI / DeepSeek / 通义 / Moonshot / 本地 vLLM 等
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.3

# ============ 可选：联网搜索 ============
# 若配置了 Tavily Key 则 Agent 自动获得实时联网搜索能力（不配则仅用内置本地工具）
# https://app.tavily.com 免费申请
TAVILY_API_KEY=

# ============ 服务端口 ============
PORT=8000
